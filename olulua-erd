  full_name varchar(150) "not null"
  email varchar(254) "unique not null, case-insensitive (citext or lower(email))"
  phone_number varchar(20) "unique, nullable"
  password_hash text "null until invitation accepted"
  account_type varchar(20) "not null: staff | customer"
  status varchar(20) "not null: invited | active | suspended | disabled"
  failed_login_count integer "not null, default 0"
  locked_until timestamptz
  last_login_at timestamptz
  email_verified_at timestamptz
  password_changed_at timestamptz
  created_at timestamptz "not null"
  updated_at timestamptz "not null"
}

sessions [icon: monitor, color: green] {
  id uuid pk
