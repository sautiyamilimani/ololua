// ==========================================
// RELATIONSHIPS
// ==========================================

// CUSTOMERS AND ACCOUNTS
customers.id < customer_meter_accounts.customer_id
service_variants.id < customer_meter_accounts.service_variant_id
zones.id < customer_meter_accounts.zone_id

// ASSIGNMENTS AND READINGS
customer_meter_accounts.id < meter_assignments.customer_meter_account_id
meters.id < meter_assignments.meter_id
users.id < meter_assignments.assigned_by
users.id < meter_assignments.removed_by

meter_assignments.id < meter_readings.meter_assignment_id
users.id < meter_readings.submitted_by

// SERVICES AND TARIFFS
service_types.id < service_variants.service_type_id
units_of_measure.id < service_variants.unit_id
service_variants.id < service_tariffs.service_variant_id
users.id < service_tariffs.created_by

// BILLING
customer_meter_accounts.id < customer_meter_billings.customer_meter_account_id
meter_readings.id - customer_meter_billings.meter_reading_id
service_tariffs.id < customer_meter_billings.service_tariff_id
users.id < customer_meter_billings.cancelled_by

// PAYMENTS
customer_meter_accounts.id < customer_meter_payments.customer_meter_account_id
users.id < customer_meter_payments.recorded_by
users.id < customer_meter_payments.reversed_by

customer_meter_payments.id < customer_meter_payment_allocations.payment_id
customer_meter_billings.id < customer_meter_payment_allocations.billing_id
customer_meter_accounts.id < customer_meter_payment_allocations.customer_meter_account_id
users.id < customer_meter_payment_allocations.created_by

// AUTH
users.id < sessions.user_id

users.id < user_roles.user_id
roles.id < user_roles.role_id
users.id < user_roles.assigned_by

roles.id < role_permissions.role_id
permissions.id < role_permissions.permission_id
users.id < role_permissions.assigned_by

users.id < invitations.user_id
users.id < invitations.invited_by
roles.id < invitations.role_id

users.id < password_reset_tokens.user_id
users.id < email_verification_tokens.user_id

users.id < customer_user_access.user_id
customers.id < customer_user_access.customer_id
users.id < customer_user_access.granted_by

users.id < audit_logs.actor_user_id
users.id < account_security_events.user_id
users.id < email_outbox.recipient_user_id
users.id < settings.updated_by

// ==========================================
// DATABASE CONSTRAINTS (cannot be drawn)
// ==========================================

// ASSIGNMENTS
// - UNIQUE (meter_id) WHERE removed_at IS NULL            -> one active assignment per meter
// - decide whether an account may have several active meters; if not:
//   UNIQUE (customer_meter_account_id) WHERE removed_at IS NULL

// READINGS
// - CHECK (current_reading >= previous_reading)
// - CHECK (consumption = current_reading - previous_reading)
// - UNIQUE (meter_assignment_id, reading_at)
// - first reading of an assignment uses meter_assignments.initial_reading as previous_reading
// - later readings use the last accepted reading of the same assignment (check inside a locked transaction)

// TARIFFS
// - EXCLUDE USING gist (service_variant_id WITH =,
//     daterange(effective_from, effective_to, '[)') WITH &&) WHERE (status = 'ACTIVE')
//   (requires the btree_gist extension)

// BILLING
// - UNIQUE (id, customer_meter_account_id) on customer_meter_billings

// PAYMENTS
// - UNIQUE (id, customer_meter_account_id) on customer_meter_payments
// - allocations: FOREIGN KEY (payment_id, customer_meter_account_id)
//     REFERENCES customer_meter_payments (id, customer_meter_account_id)
// - allocations: FOREIGN KEY (billing_id, customer_meter_account_id)
//     REFERENCES customer_meter_billings (id, customer_meter_account_id)
//   together these enforce rule 30 (same account)
// - CHECK (amount > 0), CHECK (allocated_amount > 0)
// - total allocations per payment <= payment amount (transaction + row lock)
// - total allocations per bill <= bill total_amount (transaction + row lock)
// - only COMPLETED payments can be allocated; reversing a payment must reverse its allocations

// AUTH
// - UNIQUE (user_id) WHERE status = 'pending' on invitations
// - ON DELETE RESTRICT or SET NULL on audit_logs, account_security_events and email_outbox FKs (never CASCADE)

// ==========================================
// BUSINESS RULES - METERED WATER
// ==========================================

// METER ASSIGNMENTS
// 1. A physical meter can have only ONE active assignment at a time.
// 2. A meter can be removed from an account and reassigned later.
// 3. Previous assignments must remain in the database.
// 4. A defective meter cannot receive new readings.
// 5. A suspended or closed account cannot receive new readings.

// METER READINGS
// 6. Current reading must be >= previous reading.
// 7. Consumption = current reading - previous reading.
// 8. Readings are automatically accepted after successful validation.
// 9. Duplicate reading submissions must be prevented.
// 10. Zero consumption is allowed but must trigger a warning.
// 11. Unusual consumption is flagged for investigation, not rejected.
// 12. Accepted readings must not be silently edited or deleted.

// MONTHLY READING PROGRESS
// 13. Each eligible active account counts once per month.
// 14. An account counts as read after at least one accepted reading.
// 15. Zero and unusual readings still count as completed readings.
// 16. Reading progress is independent of invoice generation.

// TARIFFS
// 17. Each service variant uses its applicable tariff.
// 18. A tariff is selected using its effective date and ACTIVE status.
// 19. Active tariff periods for the same variant must not overlap.
// 20. Historical tariffs must be retained.
// 21. Existing invoices must retain their original tariff rate.

// BILLING
// 22. Every accepted meter reading generates one invoice.
// 23. A reading must never generate more than one invoice.
// 24. Invoice amounts and reading values must be stored as snapshots.
// 25. Billing periods represent the interval between readings.
// 26. OVERDUE is calculated from due date and outstanding balance.

// PAYMENTS
// 27. A payment belongs to one customer meter account.
// 28. A payment can be allocated across multiple invoices.
// 29. An invoice can receive multiple payments.
// 30. Allocations must belong to the same customer meter account.
// 31. Total allocations cannot exceed the payment amount.
// 32. Total allocations cannot exceed an invoice's outstanding balance.
// 33. Unallocated payment amounts remain as customer credit.
// 34. Duplicate external payment references must be rejected.
// 35. Payments and allocations must not be silently deleted.
// 36. Corrections and reversals must be auditable.